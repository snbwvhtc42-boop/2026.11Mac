function refreshMatchUI(qid) {
  const item = questions.find(function(q) { return q.id === qid; });
  const st = matchState[qid];
  const pairLabels = ["配对①", "配对②", "配对③", "配对④"];
  const strokeColors = ["#0071e3", "#10b981", "#8b5cf6", "#d97706"];

  item.leftItems.forEach(function(_, lIdx) {
    const el = document.getElementById("match-L-" + qid + "-" + lIdx);
    const tag = document.getElementById("match-Ltag-" + qid + "-" + lIdx);
    if (!el || !tag) return;
    el.className = "match-item";
    tag.style.display = "none";
    if (st.pickedLeft === lIdx) {
      el.classList.add("active-pick");
    }
    if (st.links.hasOwnProperty(lIdx)) {
      el.classList.add("pair-color-" + lIdx);
      tag.className = "match-tag pair-tag-" + lIdx;
      tag.innerText = pairLabels[lIdx];
      tag.style.display = "inline-block";
    }
  });

  item.displayRightOrder.forEach(function(origRIdx, dispPos) {
    const el = document.getElementById("match-R-" + qid + "-" + dispPos);
    const tag = document.getElementById("match-Rtag-" + qid + "-" + dispPos);
    if (!el || !tag) return;
    el.className = "match-item";
    tag.style.display = "none";

    Object.keys(st.links).forEach(function(lKey) {
      if (st.links[lKey] === origRIdx) {
        const cIdx = parseInt(lKey, 10);
        el.classList.add("pair-color-" + cIdx);
        tag.className = "match-tag pair-tag-" + cIdx;
        tag.innerText = pairLabels[cIdx];
        tag.style.display = "inline-block";
      }
    });
  });

  const svg = document.getElementById("match-svg-" + qid);
  const board = document.getElementById("match-board-" + qid);
  if (!svg || !board) return;
  const svgRect = svg.getBoundingClientRect();
  let pathsHtml = "";

  Object.keys(st.links).forEach(function(lKey) {
    const lIdx = parseInt(lKey, 10);
    const origRIdx = st.links[lKey];
    const dispPos = item.displayRightOrder.indexOf(origRIdx);
    const leftEl = document.getElementById("match-L-" + qid + "-" + lIdx);
    const rightEl = document.getElementById("match-R-" + qid + "-" + dispPos);
    if (leftEl && rightEl && svgRect.width > 0) {
      const lRect = leftEl.getBoundingClientRect();
      const rRect = rightEl.getBoundingClientRect();
      const x1 = 0;
      const y1 = (lRect.top + lRect.height / 2) - svgRect.top;
      const x2 = svgRect.width;
      const y2 = (rRect.top + rRect.height / 2) - svgRect.top;
      const cx1 = svgRect.width * 0.45;
      const cx2 = svgRect.width * 0.55;
      const color = strokeColors[lIdx] || "#0071e3";
      pathsHtml +=
        '<path d="M ' + x1 + " " + y1 + " C " + cx1 + " " + y1 + ", " + cx2 + " " + y2 + ", " + x2 + " " + y2 +
        '" stroke="' + color + '" stroke-width="3.5" fill="none" stroke-linecap="round"/>' +
        '<circle cx="' + x1 + '" cy="' + y1 + '" r="5" fill="' + color + '"/>' +
        '<circle cx="' + x2 + '" cy="' + y2 + '" r="5" fill="' + color + '"/>';
    }
  });
  svg.innerHTML = pathsHtml;
}

