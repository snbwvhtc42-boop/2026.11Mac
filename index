<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>在售Mac全系产品与销售推荐测试卷</title>
<style>
  * { box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
    background: linear-gradient(135deg, #eef2f7 0%, #e4ebf5 100%);
    color: #1d1d1f;
    margin: 0;
    padding: 28px 16px;
    line-height: 1.65;
    font-size: 18px;
  }
  .container {
    max-width: 1020px;
    margin: 0 auto;
    background: #ffffff;
    border-radius: 22px;
    padding: 36px;
    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.08);
    position: relative;
    z-index: 2;
  }
  .hero-header {
    background: linear-gradient(120deg, #1d1d1f 0%, #2c3e50 50%, #0071e3 100%);
    color: #ffffff;
    padding: 28px 26px;
    border-radius: 18px;
    text-align: center;
    margin-bottom: 20px;
    box-shadow: 0 6px 20px rgba(0, 113, 227, 0.18);
  }
  .hero-header h1 {
    font-size: 30px;
    margin: 0 0 10px 0;
    letter-spacing: 0.5px;
  }
  .hero-header .subtitle {
    color: rgba(255, 255, 255, 0.92);
    font-size: 16px;
    margin: 0;
  }
  .control-panel {
    display: flex;
    gap: 16px;
    margin-bottom: 16px;
    padding: 16px 20px;
    background: #f5f7fa;
    border-radius: 14px;
    border: 1px solid #e2e8f0;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
  }
  .control-group {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .control-panel label {
    font-size: 17px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
    color: #1e293b;
  }
  .control-panel input[type="text"] {
    padding: 9px 14px;
    border: 1px solid #cbd5e1;
    border-radius: 9px;
    font-size: 17px;
    background: #ffffff;
    outline: none;
    width: 180px;
  }
  .control-panel input[type="text"]:focus {
    border-color: #0071e3;
    box-shadow: 0 0 0 3px rgba(0, 113, 227, 0.15);
  }
  .mode-switch {
    display: inline-flex;
    background: #e2e8f0;
    padding: 4px;
    border-radius: 10px;
    gap: 4px;
  }
  .mode-btn {
    padding: 8px 14px;
    border: none;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    background: transparent;
    color: #475569;
    transition: all 0.15s;
  }
  .mode-btn.active {
    background: #0071e3;
    color: #ffffff;
    box-shadow: 0 2px 6px rgba(0, 113, 227, 0.25);
  }
  .top-tool-btn {
    padding: 8px 14px;
    border-radius: 9px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    color: #334155;
  }
  .top-tool-btn:hover {
    background: #f1f5f9;
  }

  /* 顶部悬浮计时器与答题进度栏 */
  .sticky-status-bar {
    position: sticky;
    top: 10px;
    z-index: 50;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(10px);
    border: 1px solid #cbd5e1;
    border-radius: 14px;
    padding: 12px 20px;
    margin-bottom: 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
  }
  .progress-info {
    font-size: 16px;
    font-weight: 700;
    color: #1e293b;
    white-space: nowrap;
  }
  .progress-track {
    flex: 1;
    height: 10px;
    background: #e2e8f0;
    border-radius: 999px;
    overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #0071e3 0%, #10b981 100%);
    transition: width 0.25s ease;
  }
  .timer-badge {
    font-size: 17px;
    font-weight: 800;
    color: #0071e3;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    padding: 4px 14px;
    border-radius: 999px;
    white-space: nowrap;
  }

  /* 排行榜面板 */
  .leaderboard-box {
    display: none;
    margin-bottom: 24px;
    padding: 22px;
    border-radius: 16px;
    background: #fffdf9;
    border: 2px solid #fde68a;
    box-shadow: 0 4px 16px rgba(245, 158, 11, 0.08);
  }
  .lb-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid #fde68a;
  }
  .lb-title {
    font-size: 20px;
    font-weight: 800;
    color: #92400e;
  }
  .lb-privacy-note {
    font-size: 14px;
    color: #b45309;
    background: #fef3c7;
    padding: 4px 10px;
    border-radius: 6px;
  }
  .lb-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 16px;
    margin-top: 8px;
  }
  .lb-table th, .lb-table td {
    padding: 10px 12px;
    text-align: left;
    border-bottom: 1px solid #f3f4f6;
  }
  .lb-table th {
    color: #6b7280;
    font-weight: 600;
    font-size: 15px;
  }
  .rank-badge {
    display: inline-block;
    min-width: 28px;
    text-align: center;
    font-weight: 800;
    border-radius: 6px;
    padding: 2px 6px;
  }
  .rank-1 { background: #fef08a; color: #854d0e; }
  .rank-2 { background: #e2e8f0; color: #334155; }
  .rank-3 { background: #fed7aa; color: #9a3412; }

  .legend-bar {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 24px;
    padding: 14px;
    background: #f8f9fb;
    border-radius: 14px;
    border: 1px solid #e5e8ef;
  }
  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.15s, box-shadow 0.15s;
    border: 2px solid transparent;
  }
  .legend-item:hover {
    transform: translateY(-1px);
  }
  .legend-item.active-cat {
    border-color: #1d1d1f;
    box-shadow: 0 2px 8px rgba(0,0,0,0.12);
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }

  /* 5大模块分类标题横幅 */
  .section-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    border-radius: 14px;
    margin-top: 32px;
    margin-bottom: 18px;
    color: #ffffff;
    font-weight: 700;
    font-size: 20px;
  }
  .banner-diff { background: linear-gradient(90deg, #0066cc 0%, #3b82f6 100%); }
  .banner-mem  { background: linear-gradient(90deg, #6d28d9 0%, #8b5cf6 100%); }
  .banner-scene{ background: linear-gradient(90deg, #047857 0%, #10b981 100%); }
  .banner-ind  { background: linear-gradient(90deg, #b45309 0%, #f59e0b 100%); }
  .banner-acc  { background: linear-gradient(90deg, #be185d 0%, #ec4899 100%); }
  .section-desc {
    font-size: 15px;
    font-weight: 500;
    opacity: 0.95;
  }

  /* 5大题目主题颜色卡片 */
  .question-card {
    padding: 20px 22px;
    margin-bottom: 18px;
    border-radius: 14px;
    border: 1px solid #e5e7eb;
    border-left-width: 6px;
    transition: box-shadow 0.2s;
  }
  .question-card:hover {
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.06);
  }
  .cat-diff { background: #f4f9ff; border-color: #cfe4ff; border-left-color: #0071e3; }
  .badge-diff { background: #d8ebff; color: #0055b3; }

  .cat-mem { background: #faf5ff; border-color: #e9d5ff; border-left-color: #8b5cf6; }
  .badge-mem { background: #ede9fe; color: #6d28d9; }

  .cat-scene { background: #f2fbf7; border-color: #c6f0dc; border-left-color: #10b981; }
  .badge-scene { background: #d1fae5; color: #047857; }

  .cat-ind { background: #fff9f2; border-color: #fde2c4; border-left-color: #f59e0b; }
  .badge-ind { background: #fef3c7; color: #b45309; }

  .cat-acc { background: #fff5f8; border-color: #ffd6e4; border-left-color: #ec4899; }
  .badge-acc { background: #fce7f3; color: #be185d; }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }
  .badge-group {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
  }
  .badge {
    display: inline-block;
    padding: 3px 12px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 700;
  }
  .badge-type-single   { background: #e0f2fe; color: #0369a1; }
  .badge-type-multi    { background: #f3e8ff; color: #7e22ce; }
  .badge-type-match    { background: #dcfce7; color: #15803d; border: 1px solid #86efac; }
  .badge-type-classify { background: #fae8ff; color: #a21caf; border: 1px solid #f0abfc; }
  .badge-type-roleplay { background: #ffedd5; color: #c2410c; border: 1px solid #fdba74; }

  .question-title {
    font-weight: 700;
    margin-bottom: 14px;
    font-size: 19px;
    color: #111827;
  }
  .options label {
    display: flex;
    align-items: center;
    padding: 10px 14px;
    margin-bottom: 8px;
    border-radius: 10px;
    cursor: pointer;
    font-size: 17px;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(0, 0, 0, 0.08);
    transition: all 0.15s;
  }
  .options label:hover {
    background: #ffffff;
    border-color: #94a3b8;
    transform: translateX(2px);
  }
  .options input {
    margin-right: 12px;
    transform: scale(1.3);
    accent-color: #0071e3;
  }

  /* 互动题型一：连连看配对样式 */
  .match-hint {
    font-size: 15px;
    color: #475569;
    margin-bottom: 12px;
    background: rgba(255,255,255,0.8);
    padding: 6px 12px;
    border-radius: 8px;
    display: inline-block;
  }
  .match-board {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 80px 1.15fr;
    gap: 0;
    align-items: stretch;
    margin-bottom: 10px;
  }
  .match-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
    z-index: 2;
  }
  .match-svg-wrap {
    position: relative;
    width: 80px;
    z-index: 1;
  }
  .match-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .match-item {
    background: #ffffff;
    border: 2px solid #cbd5e1;
    border-radius: 12px;
    padding: 12px 14px;
    font-size: 16px;
    cursor: pointer;
    transition: all 0.15s;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: 68px;
  }
  .match-item:hover {
    border-color: #0071e3;
    background: #f8fbff;
  }
  .match-item.active-pick {
    border-color: #0071e3;
    background: #eff6ff;
    box-shadow: 0 0 0 3px rgba(0, 113, 227, 0.22);
  }
  .match-tag {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .pair-color-0 { border-color: #0071e3 !important; background: #eff6ff !important; }
  .pair-tag-0   { background: #0071e3; color: #ffffff; }
  .pair-color-1 { border-color: #10b981 !important; background: #ecfdf5 !important; }
  .pair-tag-1   { background: #10b981; color: #ffffff; }
  .pair-color-2 { border-color: #8b5cf6 !important; background: #f5f3ff !important; }
  .pair-tag-2   { background: #8b5cf6; color: #ffffff; }
  .pair-color-3 { border-color: #f59e0b !important; background: #fffbeb !important; }
  .pair-tag-3   { background: #d97706; color: #ffffff; }

  /* 互动题型二：双盒归类题样式 */
  .classify-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 14px;
  }
  .classify-row {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .classify-text {
    font-size: 16.5px;
    font-weight: 600;
    color: #1e293b;
    flex: 1;
    min-width: 240px;
  }
  .classify-btns {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .cls-btn {
    padding: 7px 14px;
    border-radius: 8px;
    border: 2px solid #cbd5e1;
    background: #f8fafc;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    color: #334155;
    transition: all 0.15s;
  }
  .cls-btn.picked-desk {
    border-color: #7c3aed;
    background: #ede9fe;
    color: #5b21b6;
  }
  .cls-btn.picked-cabinet {
    border-color: #0284c7;
    background: #e0f2fe;
    color: #0369a1;
  }
  .buckets-preview {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 8px;
  }
  .bucket-box {
    padding: 12px 14px;
    border-radius: 10px;
    font-size: 15px;
    background: rgba(255,255,255,0.85);
    border: 1px dashed #94a3b8;
  }
  .bucket-title {
    font-weight: 700;
    margin-bottom: 4px;
    color: #334155;
  }

  /* 互动题型三：实战题样式 */
  .customer-bubble {
    background: #fffbeb;
    border: 2px solid #fcd34d;
    border-radius: 14px;
    padding: 14px 18px;
    margin-bottom: 14px;
    font-size: 16.5px;
    color: #78350f;
    font-weight: 600;
  }
  .rp-step {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 12px 16px;
    margin-bottom: 10px;
  }
  .rp-step-title {
    font-size: 16px;
    font-weight: 700;
    color: #b45309;
    margin-bottom: 8px;
  }
  .rp-choices {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .rp-choice-btn {
    text-align: left;
    padding: 9px 14px;
    border-radius: 9px;
    border: 2px solid #e2e8f0;
    background: #f8fafc;
    font-size: 16px;
    cursor: pointer;
    color: #1e293b;
    transition: all 0.15s;
  }
  .rp-choice-btn:hover {
    background: #ffffff;
    border-color: #94a3b8;
  }
  .rp-choice-btn.rp-selected {
    border-color: #d97706;
    background: #fef3c7;
    color: #78350f;
    font-weight: 700;
  }

  .verify-single-btn {
    margin-top: 8px;
    padding: 7px 16px;
    font-size: 15px;
    font-weight: 600;
    border-radius: 8px;
    background: #0071e3;
    color: #ffffff;
    border: none;
    cursor: pointer;
  }
  .verify-single-btn:hover {
    background: #005bb5;
  }
  .reset-sub-btn {
    margin-top: 8px;
    margin-left: 8px;
    padding: 7px 14px;
    font-size: 14px;
    font-weight: 600;
    border-radius: 8px;
    background: #e2e8f0;
    color: #334155;
    border: none;
    cursor: pointer;
  }
  .feedback {
    display: none;
    margin-top: 14px;
    padding: 12px 16px;
    border-radius: 10px;
    font-size: 16px;
    line-height: 1.6;
  }
  .feedback.correct {
    background: #dcfce7;
    color: #166534;
    border: 1px solid #86efac;
  }
  .feedback.partial {
    background: #fef9c3;
    color: #854d0e;
    border: 1px solid #fde047;
  }
  .feedback.wrong {
    background: #fee2e2;
    color: #991b1b;
    border: 1px solid #fca5a5;
  }
  .exp-text {
    margin-top: 6px;
    color: #1f2937;
    font-weight: 400;
  }
  .actions {
    margin-top: 34px;
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .actions button {
    padding: 12px 28px;
    border: none;
    border-radius: 10px;
    font-size: 17px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
  }
  .btn-submit {
    background: linear-gradient(135deg, #0071e3 0%, #0055b3 100%);
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(0, 113, 227, 0.3);
  }
  .btn-submit:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(0, 113, 227, 0.4);
  }
  .btn-wrong {
    display: none;
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);
  }
  .btn-secondary {
    background: #e2e8f0;
    color: #1e293b;
  }
  .btn-secondary:hover {
    background: #cbd5e1;
  }
  .score-banner {
    display: none;
    margin-top: 16px;
    margin-bottom: 24px;
    padding: 24px;
    border-radius: 16px;
    background: linear-gradient(135deg, #eff6ff 0%, #e0e7ff 100%);
    border: 2px solid #93c5fd;
    text-align: center;
  }
  .score-main {
    font-size: 25px;
    font-weight: 800;
    color: #1e3a8a;
  }
  .score-sub {
    margin-top: 8px;
    font-size: 16px;
    color: #334155;
  }

  /* 满屏礼花画布 */
  #confettiCanvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 9999;
  }
</style>
</head>
<body>

<canvas id="confettiCanvas"></canvas>

<div class="container">
  <div class="hero-header">
    <h1>在售Mac全系产品与销售推荐测试卷</h1>
    <p class="subtitle">一共30题 | 满分100分</p>
  </div>

  <!-- 顶部控制栏：姓名、答题模式切换、音效开关、排行榜 -->
  <div class="control-panel">
    <div class="control-group">
      <label>姓名 <input type="text" id="username" placeholder="请输入姓名"></label>
      <div class="mode-switch">
        <button type="button" id="modeInstantBtn" class="mode-btn active" onclick="setQuizMode('instant')">模式一：逐题验证答案</button>
        <button type="button" id="modeExamBtn" class="mode-btn" onclick="setQuizMode('exam')">模式二：整卷答完看答案</button>
      </div>
    </div>
    <div class="control-group">
      <button type="button" id="soundToggleBtn" class="top-tool-btn" onclick="toggleSound()">🔊 音效：开启</button>
      <button type="button" class="top-tool-btn" onclick="toggleLeaderboard()">🏆 排行榜</button>
    </div>
  </div>

  <!-- 悬浮计时器与答题进度条 -->
  <div class="sticky-status-bar">
    <div class="progress-info" id="progressText">📋 已答 0 / 30 题</div>
    <div class="progress-track">
      <div class="progress-fill" id="progressFill"></div>
    </div>
    <div class="timer-badge" id="timerBadge">⏱️ 用时 00:00</div>
  </div>

  <!-- 排行榜展示区（按先分数后用时排名，默认仅显示前10名，管理员密码解锁全部） -->
  <div id="leaderboardBox" class="leaderboard-box">
    <div class="lb-header">
      <div>
        <span class="lb-title">🏆 成绩排行榜（按先得分、后答题用时排序）</span>
        <span id="lbPrivacyNote" class="lb-privacy-note">隐私保护中：当前仅展示前10名</span>
      </div>
      <div class="control-group">
        <button type="button" id="adminBtn" class="top-tool-btn" onclick="toggleAdminMode()">🔒 管理员查看全部</button>
        <button type="button" id="exportCsvBtn" class="top-tool-btn" style="display:none;" onclick="exportLeaderboardCSV()">导出全部成绩</button>
        <button type="button" id="clearLbBtn" class="top-tool-btn" style="display:none;color:#c91c24;" onclick="clearLeaderboard()">清空记录</button>
