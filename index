/* 统一评分函数 */
function evaluateQuestion(item) {
  let qScore = 0;
  let userSummary = "";
  let correctSummary = "";

  if (item.type === "single") {
    const inputs = document.querySelectorAll('input[name="q' + item.id + '"]:checked');
    const selected = Array.from(inputs).map(function(el) { return el.value; });
    if (selected.length === 1 && selected[0] === item.ans[0]) {
      qScore = item.points;
    }
    userSummary = selected.length > 0 ? selected.join("") : "未作答";
    correctSummary = item.ans.join("");
  } else if (item.type === "multi") {
    const inputs = document.querySelectorAll('input[name="q' + item.id + '"]:checked');
    const selected = Array.from(inputs).map(function(el) { return el.value; });
    if (selected.length > 0) {
      let hasWrong = false;
      selected.forEach(function(val) {
        if (item.ans.indexOf(val) === -1) {
          hasWrong = true;
        }
      });
      if (!hasWrong) {
        qScore = selected.length;
      }
    }
    userSummary = selected.length > 0 ? selected.join("") : "未作答";
    correctSummary = item.ans.join("");
  } else if (item.type === "match") {
    const st = matchState[item.id];
    let rightPairs = 0;
    const totalPairs = item.leftItems.length;
    for (let i = 0; i < totalPairs; i++) {
      if (st.links.hasOwnProperty(i) && st.links[i] === i) {
        rightPairs += 1;
      }
    }
    qScore = rightPairs;
    userSummary = "连对 " + rightPairs + " / " + totalPairs + " 组";
    correctSummary = "左①至④分别对应专属定位与场景（详见下方解析）";
  } else if (item.type === "classify") {
    const st = classifyState[item.id];
    let rightCount = 0;
    item.items.forEach(function(sub, idx) {
      if (st[idx] === sub.target) {
        rightCount += 1;
      }
    });
    qScore = rightCount;
    userSummary = "归对 " + rightCount + " / " + item.items.length + " 项";
    correctSummary = "第①、③项归入左盒，第②、④项归入右盒";
  } else if (item.type === "roleplay") {
    const st = roleplayState[item.id];
    let rightSteps = 0;
    const ansLetters = [];
    item.steps.forEach(function(step, sIdx) {
      ansLetters.push(["A", "B", "C"][step.ans]);
      if (st[sIdx] === step.ans) {
        rightSteps += 1;
      }
    });
    qScore = rightSteps;
    userSummary = "选对 " + rightSteps + " / " + item.steps.length + " 步";
    correctSummary = "三步正确组合为 " + ansLetters.join(" - ");
  }

  return { qScore: qScore, userSummary: userSummary, correctSummary: correctSummary };
}

function showQuestionFeedback(item, result) {
  const fb = document.getElementById("fb" + item.id);
  const card = document.getElementById("card" + item.id);
  const qScore = result.qScore;
  fb.style.display = "block";

  if (qScore === item.points) {
    card.setAttribute("data-perfect", "true");
    fb.className = "feedback correct";
    fb.innerHTML =
      "<div><strong>✅ 回答正确（+" + qScore + "分）</strong> | 你的作答：" + result.userSummary + " | 标准答案：" + result.correctSummary + "</div>" +
      '<div class="exp-text">解析：' + item.exp + "</div>";
  } else if (qScore > 0) {
    card.setAttribute("data-perfect", "false");
    fb.className = "feedback partial";
    fb.innerHTML =
      "<div><strong>⚠️ 部分正确（+" + qScore + "分 / 满分" + item.points + "分）</strong> | 你的作答：" + result.userSummary + " | 标准答案：" + result.correctSummary + "</div>" +
      '<div class="exp-text">解析：' + item.exp + "</div>";
  } else {
    card.setAttribute("data-perfect", "false");
    fb.className = "feedback wrong";
    fb.innerHTML =
      "<div><strong>❌ 未得分（0分 / 满分" + item.points + "分）</strong> | 你的作答：" + result.userSummary + " | 标准答案：" + result.correctSummary + "</div>" +
      '<div class="exp-text">解析：' + item.exp + "</div>";
  }
}

/* 模式一：单题立即验证 */
function verifyOneQuestion(qid) {
  const item = questions.find(function(q) { return q.id === qid; });
  if (!item) return;
  const res = evaluateQuestion(item);
  showQuestionFeedback(item, res);
  if (res.qScore === item.points) {
    playSoundCorrect();
  } else {
    playSoundWrong();
  }
}

/* 整卷提交计分与排行榜记录 */
function gradeQuiz(saveToLb) {
  quizSubmitted = true;
  let totalScore = 0;
  let fullCorrectCount = 0;
  let wrongIds = [];

  questions.forEach(function(item) {
    const res = evaluateQuestion(item);
    totalScore += res.qScore;
    showQuestionFeedback(item, res);
    if (res.qScore === item.points) {
      fullCorrectCount += 1;
    } else {
      wrongIds.push(item.id);
    }
  });

  const banner = document.getElementById("scoreBanner");
  const scoreMain = document.getElementById("scoreMain");
  const scoreSub = document.getElementById("scoreSub");
  const btnFilter = document.getElementById("btnFilterWrong");
  const nameInput = document.getElementById("username").value.trim();
  const name = nameInput || "匿名同事";
  const durationText = formatDuration(elapsedSeconds);

  banner.style.display = "block";
  scoreMain.innerText = name + " 的测试总分：" + totalScore + " / 100 分（用时 " + durationText + "）";

  if (wrongIds.length === 0) {
    scoreSub.innerText = "🎉 太棒了！全部30题均拿满分！";
    btnFilter.style.display = "none";
    celebrateFullScore();
  } else {
    scoreSub.innerText = "满分题目：" + fullCorrectCount + " 题 | 错题及未满分的题目（共 " + wrongIds.length + " 题）：第 " + wrongIds.join("、") + " 题";
    btnFilter.style.display = "inline-block";
    playSoundSubmit();
  }

  if (saveToLb) {
    saveScoreToLeaderboard(name, totalScore, elapsedSeconds);
    document.getElementById("leaderboardBox").style.display = "block";
    renderLeaderboard();
  }

  showingWrongOnly = false;
  applyFilterView();
  window.scrollTo({ top: 0, behavior: "smooth" });
}

/* 排行榜逻辑（按先分数从高到低，再按答题用时从短到长排序） */
function getLeaderboardData() {
  try {
    const raw = localStorage.getItem(LB_STORAGE_KEY);
    return raw ? JSON.parse(raw) : [];
  } catch (e) {
    return [];
  }
}

function saveScoreToLeaderboard(name, score, durationSec) {
  const list = getLeaderboardData();
  const now = new Date();
  const pad = function(n) { return n < 10 ? "0" + n : "" + n; };
  const timeStr = (now.getMonth() + 1) + "-" + pad(now.getDate()) + " " + pad(now.getHours()) + ":" + pad(now.getMinutes());
  list.push({
    name: name,
    score: score,
    durationSec: durationSec,
    durationStr: formatDuration(durationSec),
    time: timeStr,
    ts: now.getTime()
  });
  list.sort(function(a, b) {
    if (b.score !== a.score) return b.score - a.score;
    const durA = typeof a.durationSec === "number" ? a.durationSec : 999999;
    const durB = typeof b.durationSec === "number" ? b.durationSec : 999999;
    if (durA !== durB) return durA - durB;
    return a.ts - b.ts;
  });
  try {
    localStorage.setItem(LB_STORAGE_KEY, JSON.stringify(list));
  } catch (e) {}
}

function renderLeaderboard() {
  const list = getLeaderboardData();
  const lbContent = document.getElementById("lbContent");
  const note = document.getElementById("lbPrivacyNote");
  const adminBtn = document.getElementById("adminBtn");
  const exportBtn = document.getElementById("exportCsvBtn");
  const clearBtn = document.getElementById("clearLbBtn");

  if (isAdmin) {
    note.innerText = "管理员模式：已解锁全部 " + list.length + " 条作答排名";
    adminBtn.innerText = "退出管理员视图";
    exportBtn.style.display = "inline-block";
    clearBtn.style.display = "inline-block";
  } else {
    note.innerText = "隐私保护中：仅公开展示前10名（管理员可查看全部）";
    adminBtn.innerText = "🔒 管理员查看全部";
    exportBtn.style.display = "none";
    clearBtn.style.display = "none";
  }

  if (list.length === 0) {
    lbContent.innerHTML = '<div style="padding:14px 0;color:#6b7280;">暂无成绩记录，提交试卷后将按“先得分、后用时”自动生成排名</div>';
    return;
  }

  const displayList = isAdmin ? list : list.slice(0, 10);
  let rowsHtml = "";
  displayList.forEach(function(item, idx) {
    const rankNum = idx + 1;
    let rankBadgeClass = "";
    if (rankNum === 1) rankBadgeClass = "rank-1";
    else if (rankNum === 2) rankBadgeClass = "rank-2";
    else if (rankNum === 3) rankBadgeClass = "rank-3";

    const durText = item.durationStr || formatDuration(item.durationSec || 0);

    rowsHtml +=
      "<tr>" +
        '<td><span class="rank-badge ' + rankBadgeClass + '">' + rankNum + "</span></td>" +
        "<td><strong>" + item.name + "</strong></td>" +
        '<td style="color:#0071e3;"><strong>' + item.score + " 分</strong></td>" +
        '<td style="color:#047857;font-weight:700;">⏱️ ' + durText + "</td>" +
        '<td style="color:#6b7280;font-size:14px;">' + item.time + "</td>" +
      "</tr>";
  });

  lbContent.innerHTML =
    '<table class="lb-table">' +
      "<thead><tr><th>名次</th><th>姓名</th><th>得分</th><th>答题用时</th><th>提交时间</th></tr></thead>" +
      "<tbody>" + rowsHtml + "</tbody>" +
    "</table>";
}

function toggleLeaderboard() {
  playSoundClick();
  const box = document.getElementById("leaderboardBox");
  if (box.style.display === "block") {
    box.style.display = "none";
  } else {
    box.style.display = "block";
    renderLeaderboard();
  }
}

function toggleAdminMode() {
  if (isAdmin) {
    isAdmin = false;
    renderLeaderboard();
    return;
  }
  const pwd = prompt("请输入管理员口令查看完整排名（默认口令：8888）：");
  if (pwd === ADMIN_PASS) {
    isAdmin = true;
    renderLeaderboard();
  } else if (pwd !== null) {
    alert("口令不正确，仅展示前10名");
  }
}

function exportLeaderboardCSV() {
  const list = getLeaderboardData();
  if (list.length === 0) return;
  let csv = "\uFEFF名次,姓名,得分,答题用时,用时秒数,提交时间\n";
  list.forEach(function(item, i) {
    const durText = item.durationStr || formatDuration(item.durationSec || 0);
    csv += (i + 1) + "," + item.name + "," + item.score + "," + durText + "," + (item.durationSec || 0) + "," + item.time + "\n";
  });
  const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = "Mac测试卷全部排名.csv";
  a.click();
}

function clearLeaderboard() {
  if (confirm("确定要清空所有排行榜记录吗？")) {
    localStorage.removeItem(LB_STORAGE_KEY);
    renderLeaderboard();
  }
}

function filterByCategory(cat) {
  currentCategory = cat;
  playSoundClick();
  document.querySelectorAll(".legend-item").forEach(function(el) {
    el.classList.remove("active-cat");
  });
  document.getElementById("filter-" + cat).classList.add("active-cat");
  applyFilterView();
}

function toggleWrongOnly() {
  showingWrongOnly = !showingWrongOnly;
  playSoundClick();
  applyFilterView();
}

function applyFilterView() {
  const btnFilter = document.getElementById("btnFilterWrong");
  btnFilter.innerText = showingWrongOnly ? "显示全部题目" : "只看错题与解析";

  const catKeys = ["diff", "mem", "scene", "ind", "acc"];
  catKeys.forEach(function(catKey) {
    const section = document.getElementById("section-" + catKey);
    const matchSectionCat = (currentCategory === "all" || currentCategory === catKey);
    if (!matchSectionCat) {
      section.style.display = "none";
      return;
    }

    let visibleCount = 0;
    const catQuestions = questions.filter(function(q) { return q.cat === catKey; });
    catQuestions.forEach(function(item) {
      const card = document.getElementById("card" + item.id);
      const matchWrong = (!showingWrongOnly || card.getAttribute("data-perfect") !== "true");
      if (matchWrong) {
        card.style.display = "block";
        visibleCount += 1;
      } else {
        card.style.display = "none";
      }
    });
    section.style.display = visibleCount > 0 ? "block" : "none";
  });

  setTimeout(function() {
    questions.forEach(function(item) {
      if (item.type === "match") {
        refreshMatchUI(item.id);
      }
    });
  }, 50);
}

function resetQuiz() {
  showingWrongOnly = false;
  currentCategory = "all";
  playSoundClick();
  document.querySelectorAll(".legend-item").forEach(function(el) {
    el.classList.remove("active-cat");
  });
  document.getElementById("filter-all").classList.add("active-cat");
  document.getElementById("scoreBanner").style.display = "none";
  document.getElementById("btnFilterWrong").style.display = "none";
  renderQuiz();
  startQuizTimer();
  window.scrollTo({ top: 0, behavior: "smooth" });
}

renderQuiz();
startQuizTimer();
</script>
