/* ==================== 计时器与进度条逻辑 ==================== */
function formatDuration(sec) {
  const m = Math.floor(sec / 60);
  const s = sec % 60;
  const mm = m < 10 ? "0" + m : "" + m;
  const ss = s < 10 ? "0" + s : "" + s;
  return mm + ":" + ss;
}

function startQuizTimer() {
  if (timerInterval) clearInterval(timerInterval);
  quizStartTime = Date.now();
  elapsedSeconds = 0;
  quizSubmitted = false;
  updateTimerUI();
  timerInterval = setInterval(function() {
    if (!quizSubmitted) {
      elapsedSeconds = Math.floor((Date.now() - quizStartTime) / 1000);
      updateTimerUI();
    }
  }, 1000);
}

function updateTimerUI() {
  const el = document.getElementById("timerBadge");
  if (el) {
    el.innerText = "⏱️ 用时 " + formatDuration(elapsedSeconds);
  }
}

function isQuestionAnswered(item) {
  if (item.type === "single" || item.type === "multi") {
    const inputs = document.querySelectorAll('input[name="q' + item.id + '"]:checked');
    return inputs.length > 0;
  } else if (item.type === "match") {
    const st = matchState[item.id];
    return st && Object.keys(st.links).length === item.leftItems.length;
  } else if (item.type === "classify") {
    const st = classifyState[item.id];
    return st && Object.keys(st).length === item.items.length;
  } else if (item.type === "roleplay") {
    const st = roleplayState[item.id];
    return st && Object.keys(st).length === item.steps.length;
  }
  return false;
}

function updateProgressUI() {
  let count = 0;
  questions.forEach(function(item) {
    if (isQuestionAnswered(item)) count += 1;
  });
  const total = questions.length;
  document.getElementById("progressText").innerText = "📋 已答 " + count + " / " + total + " 题";
  document.getElementById("progressFill").style.width = Math.round((count / total) * 100) + "%";
}

/* ==================== Web Audio 合成音效系统 ==================== */
let audioCtx = null;
function getAudioCtx() {
  if (!audioCtx) {
    const AudioContextClass = window.AudioContext || window.webkitAudioContext;
    if (AudioContextClass) {
      audioCtx = new AudioContextClass();
    }
  }
  if (audioCtx && audioCtx.state === "suspended") {
    audioCtx.resume();
  }
  return audioCtx;
}

function playTone(freq, type, duration, delay) {
  if (!soundEnabled) return;
  const ctx = getAudioCtx();
  if (!ctx) return;
  const startTime = ctx.currentTime + (delay || 0);
  const osc = ctx.createOscillator();
  const gain = ctx.createGain();
  osc.type = type || "sine";
  osc.frequency.setValueAtTime(freq, startTime);
  gain.gain.setValueAtTime(0.14, startTime);
  gain.gain.exponentialRampToValueAtTime(0.001, startTime + duration);
  osc.connect(gain);
  gain.connect(ctx.destination);
  osc.start(startTime);
  osc.stop(startTime + duration);
}

function playSoundClick() { playTone(620, "sine", 0.05, 0); }
function playSoundCorrect() {
  playTone(523.25, "triangle", 0.14, 0);
  playTone(659.25, "triangle", 0.18, 0.1);
}
function playSoundWrong() {
  playTone(260, "sawtooth", 0.16, 0);
  playTone(210, "sawtooth", 0.22, 0.12);
}
function playSoundSubmit() {
  playTone(440, "triangle", 0.12, 0);
  playTone(554.37, "triangle", 0.12, 0.1);
  playTone(659.25, "triangle", 0.24, 0.2);
}
function playSoundFanfare() {
  const notes = [523.25, 659.25, 783.99, 1046.5, 783.99, 1046.5];
  const times = [0, 0.12, 0.24, 0.36, 0.55, 0.70];
  const durs  = [0.12, 0.12, 0.12, 0.22, 0.14, 0.45];
  for (let i = 0; i < notes.length; i++) {
    playTone(notes[i], "triangle", durs[i], times[i]);
  }
}

